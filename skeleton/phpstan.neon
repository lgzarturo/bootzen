includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 8
    paths:
        - app
        - bootstrap
        - config
        - public
        - routes
        - tests
    bootstrapFiles:
        - framework/bootstrap.php
    ignoreErrors:
        # Las expectativas de Pest (expect()->toBe()) se declaran como clases internas de Pest
        -
            identifier: method.internalClass
            path: tests/*
