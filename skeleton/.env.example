# Entorno de la aplicación. Copia este archivo a .env (bootzen-new lo hace por ti).
# Las variables del servidor (Docker, hosting) tienen prioridad sobre este archivo.

APP_NAME="__APP_NAME__"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_KEY=

# debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug
