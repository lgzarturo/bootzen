# Entorno de la aplicación. Copia este archivo a .env (bootzen-new lo hace por ti).
# Las variables del servidor (Docker, hosting) tienen prioridad sobre este archivo.

APP_NAME="__APP_NAME__"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_KEY=

# debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

# Sesiones: file (storage/sessions) o array. Duración en minutos
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Caché y límites de peticiones: file o array
CACHE_DRIVER=file

# Correo: log (lo escribe en storage/logs), smtp (envío real) o array (tests)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=hola@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Con MAIL_DRIVER=smtp. MAIL_ENCRYPTION: tls (587), ssl (465) o none (servidor local)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Instalación desde el navegador (/_bootzen/instalar) si el hosting no tiene terminal.
# Actívala solo para la primera instalación y vuelve a ponerla en false
INSTALL_ENABLED=false

# Base de datos: sqlite (por defecto) o mysql
DB_CONNECTION=sqlite
DB_DATABASE=database/app.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
