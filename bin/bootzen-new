#!/usr/bin/env php
<?php

/**
 * bootzen-new
 *
 * Crea un proyecto nuevo copiando skeleton/ y framework/ del repositorio BootZen.
 *
 * Uso:
 *   bin/bootzen-new [nombre] [--auth] [--no-git]
 *
 * El proyecto se crea en el directorio actual. Si no se indica nombre se usa "my-php-app".
 * --auth agrega registro, login, logout y recuperación de contraseña (stubs/auth).
 *
 * @package    BootZen
 * @author     Arturo Lopez <lgzarturo@gmail.com>
 * @copyright  2025 BootZen
 * @license    MIT
 * @since      2.0.0
 */

declare(strict_types=1);

const BOOTZEN_PLACEHOLDER_EXTENSIONS = ['php', 'json', 'md', 'neon', 'xml', 'example'];

/**
 * Escribe un mensaje de error y termina con código 1.
 */
function bootzenFail(string $message): never
{
    fwrite(STDERR, "\033[0;31mError:\033[0m {$message}\n");
    exit(1);
}

/**
 * Copia un directorio de forma recursiva, incluyendo archivos ocultos.
 */
function bootzenCopyDirectory(string $source, string $destination): void
{
    if (! is_dir($destination) && ! mkdir($destination, 0775, true)) {
        bootzenFail("No se pudo crear el directorio {$destination}");
    }

    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );

    /** @var SplFileInfo $item */
    foreach ($iterator as $item) {
        $target = $destination . '/' . substr($item->getPathname(), strlen($source) + 1);

        if ($item->isDir()) {
            if (! is_dir($target) && ! mkdir($target, 0775, true)) {
                bootzenFail("No se pudo crear el directorio {$target}");
            }

            continue;
        }

        if (! copy($item->getPathname(), $target)) {
            bootzenFail("No se pudo copiar {$item->getPathname()}");
        }

        // copy() no conserva los permisos: bin/bootzen debe seguir siendo ejecutable
        $permissions = fileperms($item->getPathname());
        if ($permissions !== false) {
            chmod($target, $permissions & 0777);
        }
    }
}

/**
 * Reemplaza los marcadores __APP_NAME__ y __APP_SLUG__ en los archivos de texto del proyecto.
 *
 * @param array<string, string> $replacements
 */
function bootzenReplacePlaceholders(string $directory, array $replacements): void
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS)
    );

    /** @var SplFileInfo $file */
    foreach ($iterator as $file) {
        if (! $file->isFile() || ! in_array($file->getExtension(), BOOTZEN_PLACEHOLDER_EXTENSIONS, true)) {
            continue;
        }

        $contents = file_get_contents($file->getPathname());
        if ($contents === false) {
            continue;
        }

        $updated = strtr($contents, $replacements);
        if ($updated !== $contents) {
            file_put_contents($file->getPathname(), $updated);
        }
    }
}

$repository = dirname(__DIR__);
$arguments = array_slice($argv, 1);
$withGit = ! in_array('--no-git', $arguments, true);
$withAuth = in_array('--auth', $arguments, true);
$positional = array_values(array_filter($arguments, static fn (string $arg): bool => ! str_starts_with($arg, '--')));
$name = $positional[0] ?? 'my-php-app';

if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true)) {
    echo "Uso: bootzen-new [nombre] [--auth] [--no-git]\n";
    echo "  --auth    registro, login, logout y recuperación de contraseña\n";
    echo "  --no-git  no inicializa un repositorio git\n";
    exit(0);
}

if (preg_match('/^[A-Za-z0-9][A-Za-z0-9._-]*$/', $name) !== 1) {
    bootzenFail("Nombre de proyecto inválido: \"{$name}\". Usa letras, números, punto, guion o guion bajo.");
}

$target = getcwd() . '/' . $name;
if (file_exists($target)) {
    bootzenFail("Ya existe {$target}. Elige otro nombre o bórralo primero.");
}

foreach ($withAuth ? ['skeleton', 'framework', 'stubs/auth'] : ['skeleton', 'framework'] as $required) {
    if (! is_dir($repository . '/' . $required)) {
        bootzenFail("No se encontró {$repository}/{$required}. ¿La instalación de BootZen está completa?");
    }
}

echo "\033[1;33mCreando {$name}...\033[0m\n";

bootzenCopyDirectory($repository . '/skeleton', $target);
bootzenCopyDirectory($repository . '/framework', $target . '/framework');

if ($withAuth) {
    // Los archivos del scaffold reemplazan a los del skeleton con el mismo nombre (rutas, layout, config/auth.php)
    bootzenCopyDirectory($repository . '/stubs/auth', $target);
}

$version = is_file($repository . '/VERSION') ? trim((string) file_get_contents($repository . '/VERSION')) : 'dev';
file_put_contents($target . '/framework/VERSION', $version . "\n");

$slug = strtolower((string) preg_replace('/[^A-Za-z0-9]+/', '-', $name));
bootzenReplacePlaceholders($target, [
    '__APP_NAME__' => $name,
    '__APP_SLUG__' => trim($slug, '-'),
]);

// .env local con una APP_KEY aleatoria (el archivo está en .gitignore)
$envExample = $target . '/.env.example';
if (is_file($envExample)) {
    $key = 'base64:' . base64_encode(random_bytes(32));
    $env = (string) preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, (string) file_get_contents($envExample));
    file_put_contents($target . '/.env', $env);
}

if ($withGit && shell_exec('git --version 2>&1') !== null) {
    exec('git -C ' . escapeshellarg($target) . ' init -q 2>&1', $output, $status);
    echo $status === 0 ? "Repositorio git inicializado.\n" : "No se pudo inicializar git, continúa sin él.\n";
}

echo <<<TXT
\033[0;32mProyecto creado con BootZen {$version}.\033[0m

Siguientes pasos:
  cd {$name}
  php bin/bootzen migrate           # crea database/app.sqlite y sus tablas
  php bin/bootzen serve             # abre http://127.0.0.1:8000
  composer install                  # opcional: tests, PHPStan y formato
  composer check

TXT;
