<x-layouts.admin :title="__('Editar') . ': ' . __('[[Heading]]') . ' #' . $[[singular]]->id">
    <x-card :title="__('Editar') . ': ' . __('[[Heading]]') . ' #' . $[[singular]]->id" class="max-w-2xl">
        <x-form :action="route('admin.[[route]].update', ['id' => $[[singular]]->id])" method="PUT">
[[editFields]]
            <div class="flex items-center gap-3">
                <x-button type="submit">{{ __('Guardar') }}</x-button>
                <x-button :href="route('admin.[[route]].index')" variant="ghost">{{ __('Cancelar') }}</x-button>
            </div>
        </x-form>
    </x-card>
</x-layouts.admin>
